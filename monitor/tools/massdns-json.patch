+/* Every lookup owns a reference. The input parser also owns one until all
+ * record types for that input name have been scheduled. */
+void release_dedicated_resolvers(dedicated_resolvers_t **slot)
+{
+    dedicated_resolvers_t *owned = *slot;
+    *slot = NULL;
+    if (owned != NULL && --owned->ref_count == 0)
+    {
+        free(owned);
+    }
